{
  "name": "@elgalas/dsh-subagent-codebuddy",
  "version": "0.1.3",
  "description": "CodeBuddy CLI plugin for DeepSeek Harness (DSH) with main-agent models, subagent delegation, and a DSH-managed MCP tool bridge.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link-profile": "node scripts/link-profile.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-error": "0.2.2-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "0.2.2-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@elgalas/dsh-mcp-tool-server": "git+https://github.com/Elgalas/dsh-mcp-tool-server.git#a971a66bd5d590ac0b19d5f4dfae08c827ed2941",
    "@types/node": "^22.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elgalas/dsh-subagent-codebuddy.git"
  },
  "homepage": "https://github.com/Elgalas/dsh-subagent-codebuddy#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codebuddy",
    "acp",
    "agent-client-protocol",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@elgalas/dsh-mcp-tool-server": "^0.1.3"
  }
}
